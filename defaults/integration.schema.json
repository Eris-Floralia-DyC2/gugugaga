{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WS connections v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "enabled",
    "daily_time",
    "initial_days",
    "lookback_days",
    "cache_limit_mb",
    "identity",
    "schedule_action",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "enabled": {
      "type": "boolean"
    },
    "daily_time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "initial_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "lookback_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "cache_limit_mb": {
      "type": "integer",
      "minimum": 64,
      "maximum": 1048576
    },
    "identity": {
      "type": "string",
      "maxLength": 4000
    },
    "schedule_action": {
      "enum": [
        "summary",
        "tasks"
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "account_id",
          "account_name",
          "db_dir",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "platform": {
            "enum": [
              "wechat",
              "feishu",
              "qq"
            ]
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "account_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "db_dir": {
            "type": "string",
            "maxLength": 2000
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
