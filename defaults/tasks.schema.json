{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tasks"],
  "properties": {
    "version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "createdAt",
          "planDate",
          "dueDate",
          "completed",
          "completedAt",
          "priority",
          "order",
          "repeat",
          "occurrences",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "createdAt": {
            "type": "string",
            "maxLength": 50
          },
          "planDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "completed": {
            "type": "boolean"
          },
          "completedAt": {
            "type": ["string", "null"]
          },
          "priority": {
            "enum": ["low", "normal", "high"]
          },
          "order": {
            "type": "number"
          },
          "repeat": {
            "enum": ["none", "daily"]
          },
          "occurrences": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}
