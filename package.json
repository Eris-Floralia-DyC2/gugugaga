{
  "name": "ws-desktop",
  "version": "0.5.5",
  "description": "Windows 11 portable desktop todo widget",
  "private": true,
  "author": "WS contributors",
  "license": "Apache-2.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.cjs",
    "build": "node scripts/build.cjs",
    "smoke": "electron . --smoke-test",
    "format": "prettier --write src test scripts defaults docs README.md ARCHITECTURE.md ROADMAP.md CONTRIBUTING.md",
    "format:check": "prettier --check src test scripts defaults docs README.md ARCHITECTURE.md ROADMAP.md CONTRIBUTING.md",
    "audit:public": "python scripts/audit-public.py"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "dompurify": "3.4.17",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.0",
    "prettier": "3.9.10"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
